{
  "aliveStatusCodes": [
    200,
    206,
    301,
    302,
    303,
    307,
    308,
    401,
    403,
    405,
    429
  ],
  "timeout": "20s",
  "retryOn429": true,
  "retryCount": 3,
  "fallbackRetryDelay": "30s",
  "httpHeaders": [
    {
      "urls": [
        "http://",
        "https://"
      ],
      "headers": {
        "User-Agent": "Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/122.0 Safari/537.36",
        "Accept": "text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8"
      }
    }
  ],
  "ignorePatterns": [
    {
      "pattern": "^https://fourms\\.github\\.io/Creative-AI/"
    },
    {
      "pattern": "^https://github\\.com/fourMs/Creative-AI/actions/"
    }
  ]
}
